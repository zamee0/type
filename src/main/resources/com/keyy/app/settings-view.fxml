<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox styleClass="root-pane" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.SettingsController">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
        <Button fx:id="backBtn" text="← Back" styleClass="btn-ghost"/>
        <Label text="⚙️ Settings" styleClass="page-title"/>
    </HBox>

    <VBox spacing="28" VBox.vgrow="ALWAYS">
        <padding><Insets top="36" right="60" bottom="36" left="60"/></padding>

        <Label text="APPEARANCE" styleClass="section-label"/>

        <VBox styleClass="settings-card" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="settings-row">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Dark Mode" styleClass="settings-label"/>
                    <Label fx:id="darkModeLabel" text="Light Mode is ON" styleClass="settings-value"/>
                </VBox>
                <ToggleButton fx:id="darkModeToggle" text="Switch to Dark" styleClass="toggle-btn"/>
            </HBox>
        </VBox>

        <Label text="GAMEPLAY" styleClass="section-label"/>

        <VBox styleClass="settings-card" spacing="0">
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="settings-row">
                <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Backspace Key" styleClass="settings-label"/>
                    <Label fx:id="backspaceLabel" text="Backspace is ON" styleClass="settings-value" wrapText="true"/>
                </VBox>
                <ToggleButton fx:id="backspaceToggle" text="Disable" styleClass="toggle-btn"/>
            </HBox>
        </VBox>

        <Label text="All settings take effect immediately." styleClass="settings-hint"/>
    </VBox>
</VBox>
