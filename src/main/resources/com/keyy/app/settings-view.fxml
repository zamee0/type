<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.keyy.app.SettingsController">

    <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
        <padding><Insets bottom="18" left="28" right="28" top="18" /></padding>
        <Button fx:id="backBtn" styleClass="btn-ghost" text="← Back" />
        <Label styleClass="page-title" text="Settings" />
    </HBox>

    <VBox spacing="28" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="36" left="60" right="60" top="36" /></padding>

        <Label styleClass="section-label" text="APPEARANCE" />
        <VBox spacing="0" styleClass="settings-card">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: transparent;">
                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
                <VBox spacing="4" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                    <Label styleClass="settings-label" text="Dark Mode" />
                    <Label fx:id="darkModeLabel" styleClass="settings-value" text="Light Mode is ON" />
                </VBox>
                <ToggleButton fx:id="darkModeToggle" styleClass="toggle-btn" text="Switch to Dark" />
            </HBox>
        </VBox>

        <Label styleClass="section-label" text="GAMEPLAY" />
        <VBox spacing="0" styleClass="settings-card">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: transparent;">
                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
                <VBox spacing="4" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                    <Label styleClass="settings-label" text="Backspace Key" />
                    <Label fx:id="backspaceLabel" styleClass="settings-value" text="Backspace is ON" wrapText="true" />
                </VBox>
                <ToggleButton fx:id="backspaceToggle" styleClass="toggle-btn" text="Disable" />
            </HBox>
        </VBox>

        <Label styleClass="section-label" text="DATA" />
        <VBox spacing="0" styleClass="settings-card">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: transparent;">
                <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
                <VBox spacing="4" style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                    <Label styleClass="settings-label" text="Clear History" />
                    <Label fx:id="clearHistoryLabel" styleClass="settings-value" text="Delete all your game history permanently." wrapText="true" />
                </VBox>
                <Button fx:id="clearHistoryBtn" styleClass="btn-danger" text="Clear" />
            </HBox>
        </VBox>

        <Label styleClass="settings-hint" />
    </VBox>
</VBox>
