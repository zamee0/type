<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.keyy.app.dashboardcontrol">
    <left>
        <VBox prefWidth="220" spacing="0" styleClass="sidebar">
            <padding><Insets bottom="28" top="28" /></padding>
            <Label styleClass="sidebar-logo" text="KEYY" />
            <Region prefHeight="24" />
            <Button fx:id="startGameBtn" maxWidth="Infinity" styleClass="nav-btn" text="  Start Game" />
            <Button fx:id="profileBtn" maxWidth="Infinity" styleClass="nav-btn" text="  My Profile" />
            <Button fx:id="statsBtn" maxWidth="Infinity" styleClass="nav-btn" text="  Stats" />
            <Button fx:id="localhostBtn" maxWidth="Infinity" styleClass="nav-btn" text="  Local Host" />
            <Button fx:id="leaderboardBtn" maxWidth="Infinity" styleClass="nav-btn" text="  Leaderboard" />
            <Button fx:id="settingsBtn" maxWidth="Infinity" styleClass="nav-btn" text="  Settings" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="logoutBtn" maxWidth="Infinity" styleClass="nav-btn-logout" text="  Logout" />
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="32" styleClass="dash-main">
            <padding><Insets bottom="60" left="70" right="70" top="60" /></padding>
            <VBox spacing="8">
                <Label fx:id="welcomeLabel" styleClass="welcome-title" text="Welcome " />
                <Label styleClass="welcome-sub" />
            </VBox>
            <Button fx:id="startGameBtnCenter" styleClass="btn-primary-large" text="Start Typing Now" />
        </VBox>
    </center>
</BorderPane>
