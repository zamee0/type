<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<VBox fx:id="rootVBox" styleClass="root-pane" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.MultiplayerController">

    <!-- TYPING PANE -->
    <VBox fx:id="typingPane" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER" spacing="0" styleClass="page-header">
            <padding><Insets top="14" right="40" bottom="14" left="40"/></padding>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label fx:id="timerLabel" text="60" styleClass="timer-big"/>
                <Label text="SECONDS LEFT" styleClass="timer-sub"/>
            </VBox>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label fx:id="wpmLiveLabel" text="0 WPM" styleClass="live-wpm"/>
                <Label text="YOUR WPM" styleClass="timer-sub"/>
            </VBox>
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <Label fx:id="opponentSummaryLabel" text="" styleClass="timer-sub" wrapText="false"/>
            </VBox>
        </HBox>

        <VBox VBox.vgrow="ALWAYS">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
            <VBox styleClass="typing-box" VBox.vgrow="ALWAYS">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                <ScrollPane fx:id="typingScroll" styleClass="typing-scroll" fitToWidth="true"
                            prefHeight="220" minHeight="220" VBox.vgrow="ALWAYS">
                    <TextFlow fx:id="textFlow" styleClass="typing-flow" lineSpacing="8"/>
                </ScrollPane>
            </VBox>
        </VBox>
    </VBox>

    <!-- RESULT PANE -->
    <ScrollPane fitToWidth="true" fx:id="resultPane" VBox.vgrow="ALWAYS" styleClass="page-scroll">
        <VBox alignment="CENTER" spacing="24">
            <padding><Insets top="36" right="60" bottom="36" left="60"/></padding>

            <Label fx:id="resultHeadingLabel" text="Time's Up!"
                   style="-fx-font-size:40px; -fx-font-weight:900;"/>
            <Label fx:id="resultSubLabel" text=""
                   style="-fx-font-size:14px; -fx-text-fill:-fx-text-2;"/>

            <HBox spacing="12" alignment="CENTER">
                <VBox styleClass="stat-card" alignment="CENTER" spacing="4" prefWidth="130">
                    <Label fx:id="wpmResultLabel" text="0" styleClass="stat-value"/>
                    <Label text="YOUR WPM" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" alignment="CENTER" spacing="4" prefWidth="130">
                    <Label fx:id="accResultLabel" text="0%" styleClass="stat-value"/>
                    <Label text="ACCURACY" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <HBox fx:id="podiumBox" alignment="BOTTOM_CENTER" spacing="8" minHeight="180"/>

            <VBox fx:id="rankingBox" spacing="8" maxWidth="500"/>

            <Label text="WPM OVER TIME" styleClass="section-label"/>
            <LineChart fx:id="wpmChart" prefHeight="220" maxWidth="600"
                       legendVisible="false" animated="false">
                <xAxis><CategoryAxis label="Time" tickLabelRotation="0"/></xAxis>
                <yAxis><NumberAxis label="WPM" lowerBound="0" autoRanging="true"/></yAxis>
            </LineChart>

            <Button fx:id="dashboardBtn" text="Back to Dashboard" styleClass="btn-primary"
                    style="-fx-padding: 12 36 12 36; -fx-font-size:14px;"/>
        </VBox>
    </ScrollPane>

</VBox>
