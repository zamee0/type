<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox styleClass="root-pane" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.LeaderboardController">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
        <Button fx:id="backBtn" text="← Back" styleClass="btn-ghost"/>
        <Label text="🏆 Leaderboard" styleClass="page-title"/>
    </HBox>

    <VBox spacing="16" VBox.vgrow="ALWAYS">
        <padding><Insets top="24" right="40" bottom="24" left="40"/></padding>
        <Label text="TOP 10 PLAYERS" styleClass="section-label"/>
        <Label fx:id="emptyLabel" text="No scores yet — play a game to get on the board!" styleClass="empty-label"/>
        <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS">
            <VBox fx:id="leaderboardList" spacing="10">
                <padding><Insets top="4" bottom="4"/></padding>
            </VBox>
        </ScrollPane>
    </VBox>
</VBox>
