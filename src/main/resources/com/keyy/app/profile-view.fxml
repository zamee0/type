<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox styleClass="root-pane" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.ProfileController">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
        <Button fx:id="backBtn" text="← Back" styleClass="btn-ghost"/>
        <Label text="My Profile" styleClass="page-title"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll">
        <VBox spacing="24">
            <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>

            <VBox spacing="4">
                <Label fx:id="usernameLabel" text="Username" styleClass="profile-name"/>
                <Label text="Typing Statistics" styleClass="profile-sub"/>
            </VBox>

            <HBox spacing="16">
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="totalGamesLabel" text="0" styleClass="stat-number"/>
                    <Label text="GAMES" styleClass="stat-card-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card-blue" HBox.hgrow="ALWAYS">
                    <Label fx:id="bestWpmLabel" text="—" styleClass="stat-number-blue"/>
                    <Label text="BEST WPM" styleClass="stat-card-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card-green" HBox.hgrow="ALWAYS">
                    <Label fx:id="avgAccLabel" text="—" styleClass="stat-number-green"/>
                    <Label text="AVG ACC" styleClass="stat-card-label"/>
                </VBox>
                <VBox alignment="CENTER" spacing="6" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="avgWpmLabel" text="—" styleClass="stat-number"/>
                    <Label text="AVG WPM" styleClass="stat-card-label"/>
                </VBox>
            </HBox>

            <Label text="RECENT GAMES" styleClass="section-label"/>
            <Label fx:id="emptyLabel" text="No games yet. Play a game to see your stats here!" styleClass="empty-label"/>
            <VBox fx:id="historyList" spacing="10"/>
        </VBox>
    </ScrollPane>
</VBox>
