<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox styleClass="root-pane" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.LocalhostController">

    <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
        <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
        <Button fx:id="backBtn" text="← Back" styleClass="btn-ghost"/>
        <Label text="Local Host" styleClass="page-title"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll">
        <VBox alignment="TOP_CENTER" spacing="32">
            <padding><Insets top="40" right="80" bottom="40" left="80"/></padding>

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="hostBtn" text="Host a Game" styleClass="btn-primary" prefWidth="200"
                        style="-fx-font-size:15px; -fx-padding: 14 32 14 32;"/>
                <Button fx:id="joinBtn" text="Join a Game" styleClass="btn-secondary" prefWidth="200"
                        style="-fx-font-size:15px; -fx-padding: 14 32 14 32;"/>
            </HBox>

            <!-- HOST PANE -->
            <VBox fx:id="hostPane" spacing="24" maxWidth="560" alignment="CENTER_LEFT">

                <Label text="DIFFICULTY" styleClass="section-label"/>
                <HBox fx:id="diffBox" spacing="10">
                    <Button fx:id="diffEasy"   text="Easy"   styleClass="setup-btn" prefWidth="100"/>
                    <Button fx:id="diffNormal" text="Normal" styleClass="setup-btn" prefWidth="100"/>
                    <Button fx:id="diffHard"   text="Hard"   styleClass="setup-btn" prefWidth="100"/>
                </HBox>

                <Label text="TIME" styleClass="section-label"/>
                <HBox fx:id="timeBox" spacing="10">
                    <Button fx:id="time15"  text="15s"  styleClass="setup-btn" prefWidth="80"/>
                    <Button fx:id="time30"  text="30s"  styleClass="setup-btn" prefWidth="80"/>
                    <Button fx:id="time60"  text="60s"  styleClass="setup-btn" prefWidth="80"/>
                    <Button fx:id="time120" text="120s" styleClass="setup-btn" prefWidth="80"/>
                </HBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius:12; -fx-border-color: #E0DDD8; -fx-border-width:1; -fx-border-radius:12; -fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label fx:id="hostIpLabel" text="Your IP: ..." styleClass="profile-name" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="copyIpBtn" text="Copy" styleClass="btn-ghost"/>
                    </HBox>
                    <Label text="Share this IP with other players" styleClass="profile-sub"/>
                </VBox>

                <Label text="PLAYERS" styleClass="section-label"/>
                <VBox fx:id="playerListBox" spacing="8"/>
                <Label fx:id="hostStatusLabel" text="" styleClass="settings-value"/>
                <Button fx:id="startGameBtn" text="Start Game" styleClass="btn-primary" prefWidth="200"/>
            </VBox>

            <!-- JOIN PANE -->
            <VBox fx:id="joinPane" spacing="16" maxWidth="400" alignment="CENTER_LEFT">
                <Label text="HOST IP" styleClass="field-label"/>
                <TextField fx:id="joinIpField" promptText="e.g. 192.168.1.5" styleClass="input-field"/>
                <Label fx:id="joinStatusLabel" text="" styleClass="settings-value" wrapText="true"/>
                <Button fx:id="connectBtn" text="Connect" styleClass="btn-primary" prefWidth="200"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
