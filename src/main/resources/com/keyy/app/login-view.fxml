<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="24" styleClass="root-pane"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.keyy.app.LoginController">

    <HBox alignment="CENTER_RIGHT">
        <padding><Insets top="16" right="20" bottom="0" left="0"/></padding>
        <Button fx:id="themeBtn" text="☽" styleClass="btn-ghost"
                style="-fx-font-size: 20px; -fx-padding: 6 12 6 12;"/>
    </HBox>

    <VBox alignment="CENTER" spacing="24" VBox.vgrow="ALWAYS">
        <Label text="KEYY" styleClass="brand-title"/>
        <Label text="Typing Speed Test" styleClass="brand-sub"/>

        <VBox spacing="14" maxWidth="320">
            <Label text="USERNAME" styleClass="field-label"/>
            <TextField fx:id="usernameField" promptText="Enter username" styleClass="input-field"/>

            <Label text="PASSWORD" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="input-field"/>

            <Label fx:id="messageLabel" text="" wrapText="true" styleClass="msg-error"/>

            <Button fx:id="loginBtn" text="Login" maxWidth="Infinity" styleClass="btn-primary"/>
            <Button fx:id="registerBtn" text="Register" maxWidth="Infinity" styleClass="btn-secondary"/>
        </VBox>
    </VBox>

</VBox>
